# VeriPilot Environment Configuration
# Copy this to the REPO ROOT (.env at VeriPilot/.env, NOT veripilot/.env)
# and fill in your credentials.

# ===========================================
# Qdrant Cloud (https://cloud.qdrant.io)
# ===========================================
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-api-key-here

# ===========================================
# Neo4j Aura (https://neo4j.com/cloud/aura-free/)
# ===========================================
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here

# ===========================================
# LeanDojo Configuration
# ===========================================
LEAN_DOJO_CACHE_DIR=data/lean_dojo_cache
LEAN_DOJO_NUM_PROCS=4

# ===========================================
# Embedding Model
# ===========================================
# Options: BAAI/bge-small-en-v1.5, BAAI/bge-base-en-v1.5, BAAI/bge-m3
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ===========================================
# HuggingFace (for embedding model downloads)
# ===========================================
# Get token at: https://huggingface.co/settings/tokens (read access)
HF_TOKEN=your-hf-token

# ===========================================
# DuckDB (local storage)
# ===========================================
DUCKDB_PATH=data/indices/lean/types.duckdb

# ===========================================
# LLM API Keys
# ===========================================
# Google Gemini (Direct API - primary for VeriPilot)
GOOGLE_API_KEY=your-google-api-key

# OpenRouter (fallback, supports multiple models)
OPENROUTER_API_KEY=your-openrouter-key

# Anthropic Claude (secondary model)
ANTHROPIC_API_KEY=your-anthropic-key

# Aristotle (Harmonic - Lean specialist)
ARISTOTLE_API_KEY=your-aristotle-key

# ===========================================
# Optional: OpenAI (for comparison/fallback)
# ===========================================
# OPENAI_API_KEY=sk-...
